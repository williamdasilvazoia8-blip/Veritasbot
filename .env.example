# ---------------------------------------------------------------- Discord
# Token do bot (Developer Portal → Bot → Reset Token). NUNCA versionar.
DISCORD_TOKEN=
# Application ID (Developer Portal → General Information).
DISCORD_CLIENT_ID=
# Opcional: registra comandos só neste servidor (aparecem na hora; ideal p/ desenvolvimento).
DISCORD_GUILD_ID=

# ---------------------------------------------------------------- Infraestrutura
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veritasbot
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
# Porta do endpoint GET /health
HEALTH_PORT=8080

# ---------------------------------------------------------------- Padrões por servidor
DEFAULT_LOCALE=pt-BR
# Fuso IANA usado para "hoje", agendamentos e mutes por mês/ano (cada servidor pode mudar com /config fuso).
DEFAULT_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------- Liturgia Diária (Dancrf)
LITURGIA_API_BASE_URL=https://liturgia.up.railway.app
# v2 = estável (padrão). v3 = beta: só é usada se LITURGIA_V3_ENABLED=true.
LITURGIA_API_VERSION=v2
LITURGIA_V3_ENABLED=false
LITURGIA_API_TIMEOUT_MS=8000
LITURGIA_MAX_RESPONSE_BYTES=2000000

# ---------------------------------------------------------------- Santos do dia (Liturgical Calendar API / LitCal)
LITCAL_ENABLED=true
LITCAL_API_BASE_URL=https://litcal.johnromanodorazio.com/api/v5
LITCAL_TIMEOUT_MS=15000
LITCAL_MAX_RESPONSE_BYTES=8000000

# ---------------------------------------------------------------- Bíblia (Matos Soares)
BIBLE_EDITION_ID=matos-soares-1956
BIBLE_AUTO_REFERENCES_ENABLED=true
# Identificação de citações coladas sem referência. Desligada até haver benchmark de precisão.
BIBLE_QUOTATION_MATCHING_ENABLED=false

# ---------------------------------------------------------------- Agendamentos
# Ocorrências perdidas durante indisponibilidade são entregues com atraso até este limite (minutos); depois, SKIPPED.
SCHEDULE_MISSED_GRACE_MINUTES=360
